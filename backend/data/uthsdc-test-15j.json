    "categories": {
      "total_max_score": 25,
      "document_url": "https://docs.google.com/document/d/1NvvlEQcS68_0QMBbvz1PevYeMskxVpu9amEB5DqTGss/edit?tab=t.szbk87ly4e7#heading=h.jwuuwp511e8s",
      "sections": [
        {
          "id": "design_process",
          "name": "Engineering Design Process",
          "max_score": 10,
          "criteria": [
            {
              "id": "1.1",
              "name": "Service Environment & Stakeholder Identification",
              "max_score": 2,
              "levels": {
                "0": "Does not identify the service environment or relevant stakeholders.",
                "1": "Identifies the service environment and some relevant stakeholders, but with no/limited explanation of their relationship to the problem (OR describes one of the two in detail but not the other one).",
                "2": "Clearly describes the service environment, identifies key stakeholders, and explains their needs and how they are affected by the problem."
              }
            },
            {
              "id": "1.2",
              "name": "Functions, Objectives & Constraints",
              "max_score": 4,
              "levels": {
                "0": "Does not identify any relevant functions, objectives, or constraints.",
                "1": "Identifies a few functions, objectives, or constraints, with significant inaccuracies or omissions.",
                "2": "Identifies all three categories, but with some inaccuracies or missing details.",
                "3": "Correctly identifies mostly relevant functions, objectives, and constraints, with only minor omissions or classification errors.",
                "4": "Clearly and accurately identifies well-defined functions, objectives, and constraints relevant to the problem. No classification errors made, and all important FOCs are mentioned."
              }
            },
            {
              "id": "1.3",
              "name": "Idea Generation Process",
              "max_score": 3,
              "levels": {
                "0": "Does not explain potential solutions and goes straight to the proposed solution.",
                "1": "Presents a few proposed solutions but provides no explanation of the brainstorming or idea generation process.",
                "2": "Presents multiple potential solutions and provides a basic explanation of how ideas were generated (i.e. names of the processes).",
                "3": "Clearly explains the idea generation methods used, including how they were applied to develop multiple distinct potential solutions."
              }
            },
            {
              "id": "1.4",
              "name": "Idea Selection Process",
              "max_score": 1,
              "levels": {
                "0": "Does not explain how the final solution was selected.",
                "1": "Explains a structured selection process and compares alternatives using relevant FOCs."
              }
            }
          ]
        },
        {
          "id": "feasibility",
          "name": "Feasibility & Functionality",
          "max_score": 6,
          "criteria": [
            {
              "id": "2.1",
              "name": "Technical Feasibility",
              "max_score": 4,
              "levels": {
                "0": "The proposed solution is not explained sufficiently to make an assessment.",
                "1": "The solution contains major technical or practical issues that prevent it from functioning as intended, with no reasonable solutions proposed.",
                "2": "The solution is generally feasible but contains significant technical or practical challenges that are not adequately considered.",
                "3": "The solution is technically feasible, with minor limitations that do not significantly affect its functionality, or major challenges with reasonable mitigation strategies proposed.",
                "4": "The solution is technically feasible, with a clear explanation of how it works and no significant unresolved technical or practical challenges."
              }
            },
            {
              "id": "2.2",
              "name": "Implementation & Real-World Impact",
              "max_score": 2,
              "levels": {
                "0": "Does not consider how the solution would be implemented or its potential impacts.",
                "1": "Provides a basic discussion of implementation considerations and/or real-world impacts (e.g. cost, accessibility, sustainability, or maintenance).",
                "2": "Clearly explains implementation considerations and evaluates relevant real-world impacts and trade-offs."
              }
            }
          ]
        },
        {
          "id": "creativity",
          "name": "Creativity & Innovation",
          "max_score": 3,
          "criteria": [
            {
              "id": "3.1",
              "name": "Originality of Solution",
              "max_score": 3,
              "levels": {
                "0": "The solution demonstrates no original or creative elements.",
                "1": "The solution is conventional, with minimal modifications to existing approaches.",
                "2": "The solution demonstrates creativity through meaningful modifications or combinations of existing approaches.",
                "3": "The solution demonstrates strong creativity through a unique approach or an innovative application of existing ideas."
              }
            }
          ]
        },
        {
          "id": "presentation",
          "name": "Presentation & Communication",
          "max_score": 6,
          "criteria": [
            {
              "id": "4.1",
              "name": "Presentation Clarity & Organization",
              "max_score": 2,
              "levels": {
                "0": "The presentation is difficult to follow and does not clearly communicate the proposed solution.",
                "1": "The presentation communicates the main idea but has noticeable issues with organization or clarity.",
                "2": "The presentation is clear, logically organized, and effectively communicates the proposed solution."
              }
            },
            {
              "id": "4.2",
              "name": "Understanding & Q&A",
              "max_score": 2,
              "levels": {
                "0": "The team cannot adequately explain its design or respond to questions about its main features.",
                "1": "The team answers basic questions but struggles to explain or justify major design decisions.",
                "2": "The team answers questions accurately, demonstrates strong understanding of its design, and clearly justifies its major design decisions."
              }
            },
            {
              "id": "4.3",
              "name": "Visual Aids",
              "max_score": 2,
              "levels": {
                "0": "Does not provide any visual aids representing the proposed solution (e.g. drawings, diagrams, 3D models, or prototypes).",
                "1": "Provides at least one relevant visual aid, but it lacks sufficient detail or clarity to effectively explain the proposed solution.",
                "2": "Provides at least one clear and detailed visual aid that effectively illustrates the proposed solution and its key features."
              }
            }
          ]
        }
      ],
      "penalties": [
        {
          "id": "plagiarism",
          "name": "Plagiarism",
          "deduction": 25
        },
        {
          "id": "school_mention",
          "name": "Mention School/District During Presentation",
          "deduction": 10
        },
        {
          "id": "disruptive",
          "name": "Disruptive Behaviour During Other Presentations",
          "deduction": 10
        },
        {
          "id": "late_docs",
          "name": "Documents Received After Deadline",
          "deduction": 5
        }
      ]
    },
